# Backend Environment Variables

# Database
DATABASE_URL=postgres://user:pass@localhost:5432/arenax
BACKEND_MIGRATION_MODE=run
REDIS_URL=redis://localhost:6379

# Storage
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=secret
S3_BUCKET=arenax

# Payments
# Active gateway for wallet deposits: paystack (default) or flutterwave
PAYMENT_PROVIDER=paystack
PAYSTACK_SECRET=sk_test_xxx
FLUTTERWAVE_SECRET=FLWSECK_TEST-xxx

# Authentication
JWT_SECRET=supersecretkey
# Short-lived access token TTL: supports s / m / h / d suffixes (e.g. "15m")
JWT_EXPIRES_IN=15m
# Long-lived refresh token TTL. Defaults to "7d" when unset.
JWT_REFRESH_EXPIRES_IN=7d

# Stellar Configuration
STELLAR_NETWORK_URL=https://horizon-testnet.stellar.org
STELLAR_ADMIN_SECRET=SBXXX...
SOROBAN_CONTRACT_PRIZE=CAXXX...
SOROBAN_CONTRACT_REPUTATION=CBXXX...
SOROBAN_CONTRACT_ARENAX_TOKEN=CCXXX...
# Optional: defaults to SOROBAN_CONTRACT_PRIZE if not set
SOROBAN_CONTRACT_MATCH=CDXXX...

# AI
AI_MODEL_PATH=./models/anti_cheat.tflite

# Server Configuration
PORT=8080
HOST=0.0.0.0
RUST_LOG=info

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
# Optional per-endpoint overrides: comma-separated bucket=limit:window pairs
# RATE_LIMIT_OVERRIDES=auth_strict=3:60,tournament=5:120,default=200:60

# Idempotency
# TTL for cached idempotent responses in seconds (default: 86400 = 24 hours)
IDEMPOTENCY_TTL_SECONDS=86400
# Maximum response body size to cache in KB (default: 1024 = 1MB)
IDEMPOTENCY_MAX_RESPONSE_SIZE_KB=1024

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Distributed tracing (OTLP/gRPC — points at a Jaeger or Datadog Agent
# collector). Leave unset to run with local logging only, no trace export.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=arenax-backend
APP_ENV=development

# Email notifications (Issue #905)
# Unset: email is written to the log instead of being delivered.
EMAIL_API_ENDPOINT=
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=
# Base URL used to build unsubscribe and appeal links in outbound email.
APP_BASE_URL=https://arenax.gg

# Hermetic integration tests (Issue #101)
# When set, integration tests use this Postgres server to create a unique,
# throwaway database per test (dropped on teardown, even after failure).
# Leave unset to skip DB-backed tests locally; CI provides a service container.
# TEST_DATABASE_URL=postgres://user:pass@localhost:5432/postgres
# Redis server used for per-test key namespacing (FLUSHDB is never called).
# TEST_REDIS_URL=redis://localhost:6379
# Object storage endpoint for per-test bucket isolation.
# TEST_S3_ENDPOINT=http://localhost:9000
# TEST_S3_ACCESS_KEY=minio
# TEST_S3_SECRET_KEY=secret
# External provider clients (Stellar, payments, email) are mocked at the
# boundary in tests; these values are only used to satisfy config loading.
