{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                id as transaction_id,\n                operation,\n                isolation_level,\n                started_at,\n                completed_at,\n                duration_ms,\n                status as \"status: TransactionStatus\",\n                retry_count,\n                error_message,\n                metadata\n            FROM transaction_monitor\n            WHERE started_at >= $1 AND started_at <= $2\n            ORDER BY started_at DESC\n            ",
