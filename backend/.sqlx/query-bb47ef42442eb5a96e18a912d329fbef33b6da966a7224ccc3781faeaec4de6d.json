  "query": "\n            SELECT id, user_id, game, match_id, rating_before, rating_after,\n                   rating_change, opponent_id, opponent_rating, result, created_at\n            FROM elo_history\n            WHERE user_id = $1 AND game = $2 AND created_at BETWEEN $3 AND $4\n            ORDER BY created_at ASC\n            ",
