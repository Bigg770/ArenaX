  "query": "\n            SELECT \n                id,\n                api_key_id,\n                endpoint,\n                method,\n                client_ip::text as \"client_ip?\",\n                user_agent,\n                response_status,\n                request_duration_ms,\n                scopes_used as \"scopes_used!\",\n                created_at\n            FROM api_key_usage_logs\n            WHERE api_key_id = $1\n            ORDER BY created_at DESC\n            LIMIT $2 OFFSET $3\n            ",
