{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT ue.*, u.username, u.avatar_url\n            FROM user_elo ue\n            JOIN users u ON ue.user_id = u.id\n            WHERE ue.game = $1\n            ORDER BY ue.current_rating DESC, ue.games_played DESC\n            LIMIT $2 OFFSET $3\n            ",
