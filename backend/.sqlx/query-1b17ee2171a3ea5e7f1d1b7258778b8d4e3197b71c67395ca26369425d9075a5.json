  "query": "\n            SELECT t.*, COUNT(tp.id) as current_participants\n            FROM tournaments t\n            LEFT JOIN tournament_participants tp ON t.id = tp.tournament_id\n            WHERE t.id = $1\n            GROUP BY t.id\n            ",
