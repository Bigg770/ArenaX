  "query": "\n        SELECT \n            id,\n            user_id,\n            event_type,\n            skill_delta,\n            fair_play_delta,\n            match_id,\n            transaction_hash,\n            created_at::text as \"created_at!\"\n        FROM reputation_events\n        WHERE user_id = $1\n        ORDER BY created_at DESC\n        LIMIT $2 OFFSET $3\n        ",
