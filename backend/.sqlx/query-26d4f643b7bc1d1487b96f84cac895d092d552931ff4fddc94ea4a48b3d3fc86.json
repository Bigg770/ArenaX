{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT \n                id, key, request_hash, response_status, response_headers, response_body,\n                created_at, expires_at, used_at\n            FROM idempotency_keys \n            WHERE key = $1 \n            AND expires_at > NOW()\n            AND used_at IS NOT NULL\n            ORDER BY created_at DESC\n            LIMIT 1\n            ",
