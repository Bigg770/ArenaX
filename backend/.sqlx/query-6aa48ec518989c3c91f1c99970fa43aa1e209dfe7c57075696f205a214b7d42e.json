  "query": "\n            SELECT tm.* FROM tournament_matches tm\n            JOIN tournament_rounds tr ON tm.round_id = tr.id\n            WHERE tm.tournament_id = $1 AND tm.status = $2\n            ORDER BY tr.round_number DESC, tm.match_number\n            ",
